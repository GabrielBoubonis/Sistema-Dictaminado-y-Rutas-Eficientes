# Copiar a .env y completar. El servidor lo lee solo (dotenv).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/arbolado
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
PORT=3000
# Costo de bcrypt (RNF-05). 12 en producción; bajarlo solo para pruebas.
BCRYPT_COST=12
# Opcional: con una clave gratuita de OpenRouteService se usa el servicio real (geocodificación y matriz de distancias);
# sin clave se usa un simulador local determinista.
ORS_API_KEY=
# Sede de la Dirección General de Parques y Paseos (punto de partida y cierre de las rutas)
SEDE_LAT=-32.9468
SEDE_LNG=-60.6393
# WebAuthn: deben coincidir con el sitio desde el que se abre la app.
#  - en esta misma computadora:  RP_ID=localhost  y ORIGIN=http://localhost:3000 (sirviendo la app compilada) o :5173 (modo desarrollo)
#  - en un celular real hace falta HTTPS: RP_ID=el-dominio  y ORIGIN=https://el-dominio
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000
# Carpeta de fotografías de los dictámenes
UPLOADS_DIR=uploads
# Solo desarrollo: permite simular el segundo factor (NO usar en producción; se ignora si NODE_ENV=production)
# WEBAUTHN_SIMULADO=1
