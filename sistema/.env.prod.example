# Copiar a .env.prod y completar (no se sube al repositorio).
# Dominio con el que se entra a la app; tiene que apuntar a la IP pública del servidor (p. ej. un subdominio gratuito de DuckDNS).
DOMINIO=arbolado-rosario.duckdns.org
# Largo y aleatorio. Generar con:  openssl rand -base64 48
JWT_SECRET=
# Clave de la base (solo la usa la app dentro del servidor). Solo letras y números, generar con:  openssl rand -hex 24
POSTGRES_PASSWORD=
# 1 = la primera vez, con la base vacía, carga los usuarios y datos de demostración (clave Demo2026!)
SEED=1
# Contacto que se envía a Nominatim (su política de uso pide identificarse)
NOMINATIM_CONTACTO=arbolado-rosario-tp
# Opcional: clave gratuita de OpenRouteService para ordenar las rutas por distancia real
ORS_API_KEY=
